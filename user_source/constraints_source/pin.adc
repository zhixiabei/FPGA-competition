
set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_rst_n }				{ LOCATION = R10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# Legacy example controls are on GPIO extension headers, not board K1-K4.
set_pin_assignment	{ I_button[0] }			{ LOCATION = N2;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[1] }			{ LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# HX1P35A manual: K1/KEY1=D5, K2=A9, K3=B9, K4=C7 (active low).
# SW1 is a maintained switch on A4: up=1 shows the latency panel, down=0 hides it.
set_pin_assignment { I_mode_key_n } { LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_detect_key_n } { LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_effect_key_n } { LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_latency_switch } { LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
# HX1P35B pin allocation table: SW2=B4. High enables fruit recognition.
set_pin_assignment { I_fruit_switch } { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { I_param_key_n } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# On-board USB-UART used by the optional CNN model loader/status link.
set_pin_assignment { I_resnet_uart_rx } { LOCATION = J1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_resnet_uart_tx } { LOCATION = H1; IOSTANDARD = LVCMOS33; }

# Independent U30 N25Q128 user Flash; not the U33 FPGA configuration Flash.
set_pin_assignment { O_model_flash_cs_n } { LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }
set_pin_assignment { O_model_flash_sck } { LOCATION = N6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_model_flash_mosi } { LOCATION = E13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { I_model_flash_miso } { LOCATION = D16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_model_flash_wp_n } { LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_model_flash_hold_n } { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }

set_pin_assignment	{ O_screen_pwm } 		{ LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }


# HX711 on GPIOA and the eight on-board seven-segment digits (SW6 DIGVCC ON).
set_pin_assignment { I_hx711_dout } { LOCATION = V2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_hx711_sck } { LOCATION = V1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[0] } { LOCATION = G15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[1] } { LOCATION = G14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[2] } { LOCATION = A17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[3] } { LOCATION = A18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[4] } { LOCATION = B16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[5] } { LOCATION = A15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[6] } { LOCATION = B15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_sel_n[7] } { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[0] } { LOCATION = C9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[1] } { LOCATION = C11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[2] } { LOCATION = B11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[3] } { LOCATION = E7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[4] } { LOCATION = E6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[5] } { LOCATION = B6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[6] } { LOCATION = B7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_seg_n[7] } { LOCATION = E5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
