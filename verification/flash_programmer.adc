set_pin_assignment { I_sys_clk } { LOCATION = C4; IOSTANDARD = LVCMOS33; }
set_pin_assignment { I_rst_n } { LOCATION = R10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_resnet_uart_rx } { LOCATION = J1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_resnet_uart_tx } { LOCATION = H1; IOSTANDARD = LVCMOS33; }
# Independent user Flash U30, HX1P35B_FT_40P_2/3/8 schematics.
set_pin_assignment { O_model_flash_cs_n } { LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }
set_pin_assignment { O_model_flash_sck } { LOCATION = N6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_model_flash_mosi } { LOCATION = E13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { I_model_flash_miso } { LOCATION = D16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_model_flash_wp_n } { LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
set_pin_assignment { O_model_flash_hold_n } { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; }
