# TD synthesis/place/route output directories, including future runs.
**/*_Runs/
/td_project/log/
.lock.f

# Simulation outputs. Keep new testbench source outside out and out_*.
/sim/out/
/sim/out_*/
xsim.dir/
.Xil/

# Logs and waveforms; source and IP configuration files remain included.
*.log
*.logw
*.jou
*.wdb
*.vcd
*.fst

# TD-generated verification reports/databases. Keep validation scripts.
/verification/*.db
/verification/*.area
/verification/*.timing
/verification/*.timingsummary
/verification/*.rpt
/verification/*.qor
/verification/*.status

# Generated programming files and optional exported archives.
*.bit
/exports/
/build/

# Retired scratch/output locations. Documents now live under docs/proposals.
/tmp/
/output/
__pycache__/
*.pyc

# Do not ignore *.bin, *.dat, *.mif, *.mem, *.hex, *.txt, *.xml, *.ipc,
# *.v, *.sv, *.vh, *.vhd, *.tcl, *.adc, *.sdc, or *.al globally.
# These can be source data, IP configuration, or project dependencies.
